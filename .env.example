# Carefold local configuration (optional)
#
# Copy to `.env` in the repository root and start the backend from the root:
#   cp .env.example .env
#
# Every setting is optional; the values below are the built-in defaults.
# Full reference: docs/getting-started/configuration.md
#
# Note: model provider API keys (GOOGLE_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY, ...) are read from the process environment, not from
# this file. Export them in your shell if you use a cloud provider.

# Core engine
CAREFOLD_LOG_LEVEL=INFO
CAREFOLD_LOG_JSON=false
# Keep false to redact prompt and completion bodies from audit logs
CAREFOLD_AUDIT_STORE_BODIES=false

# Local Ollama inference
CAREFOLD_OLLAMA_URL=http://127.0.0.1:11434/v1
CAREFOLD_DEFAULT_MODEL=llama3.2
CAREFOLD_MODEL_TIMEOUT_SECONDS=30.0

# Memory and catalog persistence (only `sqlite` is implemented today)
CAREFOLD_MEMORY_BACKEND=sqlite
